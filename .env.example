# Bybit Price Alert Bot - Environment Variables
# Copy this file to .env and fill in your values

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=7123456789:AAH...your_bot_token_here

# Telegram Channel ID where alerts will be sent
# For channels, use the format: -100123456789
# For groups, you can use the chat ID
TELEGRAM_CHANNEL_ID=-1001234567890

# Telegram Topic/Thread ID (optional)
# For forum-style groups with topics enabled
# Leave empty or remove if not using topics
# Get the topic ID from the URL when viewing a topic: t.me/c/123456789/123 (last number is topic ID)
TELEGRAM_TOPIC_ID=

# Admin User IDs (comma-separated)
# Get your user ID by messaging @userinfobot on Telegram
ADMIN_USER_IDS=123456789,987654321

# PostgreSQL Database URL
# Railway provides this automatically if you add a PostgreSQL service
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
